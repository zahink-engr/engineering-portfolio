---
const { type, compact = false } = Astro.props;
---
{type === 'shinkei' ? <div class:list={['system-visual','shinkei-visual',{compact}]} role="img" aria-label="Scope diagram connecting mechanical design, robotic hardware, sensing, and experimental methods"><div class="visual-top"><span>ENGINEERING SCOPE</span><span>SHINKEI SYSTEMS</span></div><div class="scope-center"><span class="cross">+</span><p>MECHANICAL<br/><strong>× SENSING</strong></p><span class="cross">+</span></div><div class="scope-grid"><div><b>01</b><span>Design &<br/>fabrication</span></div><div><b>02</b><span>Robotic<br/>hardware</span></div><div><b>03</b><span>Experimental<br/>methods</span></div></div><div class="visual-bottom">ROLE OVERVIEW <span>R&D / QUALITY ENGINEERING</span></div></div> : <div class:list={['system-visual','roaster-visual',{compact}]}><div class="visual-top"><span>PROPOSED ARCHITECTURE</span><span>COFFEE ROASTER / V1</span></div><div class="flow"><div>Airflow<br/><small>Blower + heater</small></div><span aria-hidden="true">→</span><div class="flow-main">Rotating drum<br/><small>Agitation + heat transfer</small></div><span aria-hidden="true">→</span><div>Exhaust<br/><small>Chaff collection</small></div></div><div class="signal-line">Temperature · RPM · Acoustics · Humidity · Power</div><div class="data-flow"><span>Planned sensor inputs</span><b aria-hidden="true">↓</b><span>Synchronized data acquisition</span></div><div class="visual-bottom">DESIGN IN DEVELOPMENT <span>CONCEPT, NOT AS-BUILT HARDWARE</span></div></div>}
