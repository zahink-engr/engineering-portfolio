---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

import { projects } from '../data/projects.js';
import { contactEmail, contactHref } from '../data/site.js';
const base=import.meta.env.BASE_URL;
---
<Layout><section class="hero wrap"><div class="hero-copy"><p class="eyebrow">ZAHIN KABIR / ENGINEERING PORTFOLIO</p><h1>Mechanical design.<br/>Robotics.<br/><em>R&D.</em></h1><div class="hero-bottom"><p>I’m Zahin, a Chemical Engineering student at Purdue.<br/>Here’s what I’ve been working on.</p><a class="text-link" href="#selected">See my projects <span aria-hidden="true">↓</span></a></div></div><a class="hero-visual" href={`${base}projects/shinkei-systems/`}><img class="hero-hardware" src={`${base}assets/shinkei/hsi-texture-lab.webp`} alt="Hyperspectral imaging and texture-analysis equipment at Shinkei" width="1200" height="1600" fetchpriority="high"/><div class="hero-caption"><span>01 / SHINKEI SYSTEMS<br/><strong>Robotics & experimental systems</strong></span><span class="round-arrow" aria-hidden="true">↗</span></div></a></section><div class="discipline-strip"><span>MECHANICAL DESIGN</span><span>PROTOTYPING</span><span>SENSING & CONTROLS</span><span>EXPERIMENTAL ENGINEERING</span></div><section class="wrap selected" id="selected"><div class="section-heading"><div><p class="eyebrow">01 / PROJECTS</p><h2>Selected work</h2></div><p>Projects from my internships,<br/>coursework, and time in the shop.</p></div><div class="project-grid">{projects.map((p,i)=><ProjectCard project={p} featured={i<2}/>)}</div><a class="additional-link" href={`${base}projects/additional/`}><span>More engineering work</span><span>EPICS at Purdue</span><span aria-hidden="true">↗</span></a></section><section class="about-band"><div class="wrap about-grid"><div><p class="eyebrow">02 / ABOUT ME</p><h2>A bit about me</h2></div><div><p>I study Chemical Engineering, but a lot of my work involves designing parts, building test equipment, and writing code. I’ve worked with fish-quality research at Shinkei, coffee processing at Keurig Dr Pepper, and pigment extraction at Ourobio.</p><a class="text-link" href={`${base}about/`}>More about me <span aria-hidden="true">↗</span></a></div></div></section><section class="wrap contact-band"><p class="eyebrow">03 / CONTACT</p><h2>Get in touch</h2><a class="text-link" href={contactHref}>{contactEmail} <span aria-hidden="true">↗</span></a></section></Layout>

