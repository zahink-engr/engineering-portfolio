---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Visual from '../components/Visual.astro';
import { projects } from '../data/projects.js';
const base=import.meta.env.BASE_URL;
---
<Layout><section class="hero wrap"><div class="hero-copy"><p class="eyebrow">ZAHIN KABIR / ENGINEERING PORTFOLIO</p><h1>Mechanical design.<br/>Robotics.<br/><em>R&D.</em></h1><div class="hero-bottom"><p>Designing physical systems.<br/>Building the tools to understand them.</p><a class="text-link" href="#selected">Explore the work <span aria-hidden="true">↓</span></a></div></div><a class="hero-visual" href={`${base}projects/shinkei-systems/`}><img class="hero-hardware" src={`${base}assets/shinkei/hsi-texture-lab.webp`} alt="Hyperspectral imaging and texture-analysis equipment at Shinkei" width="1200" height="1600" fetchpriority="high"/><div class="hero-caption"><span>01 / SHINKEI SYSTEMS<br/><strong>Robotics & experimental systems</strong></span><span class="round-arrow" aria-hidden="true">↗</span></div></a></section><div class="discipline-strip"><span>MECHANICAL DESIGN</span><span>PROTOTYPING</span><span>SENSING & CONTROLS</span><span>EXPERIMENTAL ENGINEERING</span></div><section class="wrap selected" id="selected"><div class="section-heading"><div><p class="eyebrow">01 / PROJECTS</p><h2>Selected work</h2></div><p>Machines, measurement tools,<br/>and the experiments behind them.</p></div><div class="project-grid">{projects.map((p,i)=><ProjectCard project={p} featured={i<2}/>)}</div><a class="additional-link" href={`${base}projects/additional/`}><span>More engineering work</span><span>Ourobio / EPICS at Purdue</span><span aria-hidden="true">↗</span></a></section><section class="about-band"><div class="wrap about-grid"><div><p class="eyebrow">02 / PERSPECTIVE</p><h2>Hardware meets<br/>process thinking.</h2></div><div><p>I work across mechanical design, experimentation, and physical processes. My Chemical Engineering background at Purdue complements hands-on experience in robotics, manufacturing, and test-equipment development.</p><a class="text-link" href={`${base}about/`}>More about me <span aria-hidden="true">↗</span></a></div></div></section><section class="wrap contact-band"><p class="eyebrow">03 / CONTACT</p><h2>Let’s talk engineering.</h2><a class="text-link" href={`${base}contact/`}>Get in touch <span aria-hidden="true">↗</span></a></section></Layout>
