---
import Layout from '../../layouts/Layout.astro';
import Visual from '../../components/Visual.astro';
import {projects} from '../../data/projects.js';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
const {project:p}=Astro.props;
const base=import.meta.env.BASE_URL;
const next=projects[(projects.findIndex(item=>item.slug===p.slug)+1)%projects.length];
---
<Layout title={`${p.title} — Zahin Kabir`} description={p.summary} active="Projects"><article><header class="wrap case-header"><a class="back" href={`${base}projects/`}>← All projects</a><p class="eyebrow">{p.number} / {p.category}</p><h1>{p.title}</h1><p class="lede">{p.summary}</p><div class="case-meta"><div><span>MY ROLE</span><p>{p.role}</p></div><div><span>TEAM CONTEXT</span><p>{p.team}</p></div><div><span>TIMELINE / STATUS</span><p>{p.period}<br/>{p.status}</p></div><div><span>TOOLS / METHODS</span><p>{p.tools.join(' · ')}</p></div></div></header><div class="wrap case-cover">{p.image ? <figure><img src={`${base}assets/${p.image}`} alt={p.alt} width="1200" height="800"/><figcaption>{p.coverCaption || "Engineering imagery from the original public portfolio."}</figcaption></figure> : <Visual type={p.visual}/>}</div><div class="wrap case-body"><aside class="contents"><p class="eyebrow">IN THIS PROJECT</p><nav aria-label="Case study sections">{p.sections.map((s,i)=><a href={`#section-${i}`}><span>{String(i+1).padStart(2,'0')}</span>{s.title}</a>)}</nav></aside><div class="case-text"><p class="case-intro">{p.intro}</p>{p.sections.map((s,i)=><section class="case-section" id={`section-${i}`}><p class="eyebrow">{String(i+1).padStart(2,'0')}</p><h2>{s.title}</h2>{s.text && <p>{s.text}</p>}{s.diagram && <Visual type="roaster" compact/>}{s.facts && <><div class="facts">{s.facts.map(([value,label])=><div><strong>{value}</strong><span>{label}</span></div>)}</div><p class="caption">{s.note}</p></>}{s.table && <div class="table-wrap"><table><thead><tr><th>{p.slug==='coffee-roaster' && s.title==='Instrumentation plan'?'Signal':'Design choice'}</th><th>Engineering purpose</th></tr></thead><tbody>{s.table.map(([a,b])=><tr><th scope="row">{a}</th><td>{b}</td></tr>)}</tbody></table></div>}{s.steps && <ol class="stages">{s.steps.map(([a,b])=><li><h3>{a}</h3><p>{b}</p><span>{s.stepsStatus || "PLANNED"}</span></li>)}</ol>}{s.image && <figure><img src={`${base}assets/${s.image}`} alt={s.alt} loading="lazy" width="1200" height="800"/><figcaption>{s.caption}</figcaption></figure>}</section>)}<blockquote>{p.takeaway}</blockquote></div></div><div class="wrap next-project"><p class="eyebrow">NEXT PROJECT</p><a href={`${base}projects/${next.slug}/`}>{next.title}<span aria-hidden="true">↗</span></a></div></article></Layout>

