---
import '../styles/global.css';
const { title = 'Zahin Kabir — Mechanical Design, Robotics & R&D', description = 'Engineering portfolio of Zahin Kabir. Mechanical design, robotics, experimental equipment, and instrumented physical systems.', active = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta name="theme-color" content="#202523"/>{canonical && <><link rel="canonical" href={canonical}/><meta property="og:url" content={canonical}/></>}<link rel="icon" href={url('favicon.svg')} type="image/svg+xml"/></head>
<body><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="brand" href={url()} aria-label="Zahin Kabir home">ZK<span>ZAHIN KABIR</span></a><nav aria-label="Main navigation">{[['Projects','projects/'],['Experience','experience/'],['About','about/'],['Resume','resume/'],['Contact','contact/']].map(([label,path])=><a href={url(path)} aria-current={active === label ? 'page' : undefined}>{label}</a>)}</nav></header><main id="main"><slot/></main><footer><a class="brand" href={url()}>ZK<span>ZAHIN KABIR</span></a><p>Mechanical design. Physical systems. Experimental engineering.</p><a href={url('contact/')}>Get in touch <span aria-hidden="true">↗</span></a><small>© {new Date().getFullYear()} Zahin Kabir</small></footer></body></html>
